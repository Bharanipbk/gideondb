<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.bharanipbk</groupId>
  <artifactId>gideondb-client</artifactId>
  <version>0.1.0</version>
  <name>GideonDB Java Client</name>
  <description>Experimental dependency-free Java client for GideonDB.</description>
  <url>https://github.com/Bharanipbk/gideondb</url>
  <licenses><license><name>Apache License, Version 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url><distribution>repo</distribution></license></licenses>
  <developers><developer><id>Bharanipbk</id><name>GideonDB maintainers</name><url>https://github.com/Bharanipbk</url></developer></developers>
  <scm><connection>scm:git:https://github.com/Bharanipbk/gideondb.git</connection><developerConnection>scm:git:ssh://git@github.com/Bharanipbk/gideondb.git</developerConnection><url>https://github.com/Bharanipbk/gideondb</url></scm>
  <properties><maven.compiler.release>17</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <build>
    <resources><resource><directory>.</directory><includes><include>LICENSE</include></includes><targetPath>META-INF</targetPath></resource></resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version></plugin>
      <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version><executions><execution><id>client-tests</id><phase>test</phase><goals><goal>exec</goal></goals><configuration><executable>java</executable><classpathScope>test</classpathScope><arguments><argument>-ea</argument><argument>-classpath</argument><classpath/><argument>io.gideondb.client.GideonDBClientTest</argument></arguments></configuration></execution></executions></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><version>3.3.1</version><executions><execution><id>sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-javadoc-plugin</artifactId><version>3.11.2</version><executions><execution><id>javadoc</id><goals><goal>jar</goal></goals></execution></executions></plugin>
    </plugins>
  </build>
  <profiles><profile><id>release</id><build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-gpg-plugin</artifactId><version>3.2.8</version><executions><execution><id>sign</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions><configuration><bestPractices>true</bestPractices></configuration></plugin>
    <plugin><groupId>org.sonatype.central</groupId><artifactId>central-publishing-maven-plugin</artifactId><version>0.12.0</version><extensions>true</extensions><configuration><publishingServerId>central</publishingServerId><autoPublish>true</autoPublish><waitUntil>published</waitUntil></configuration></plugin>
  </plugins></build></profile></profiles>
</project>
